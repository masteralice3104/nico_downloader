{
    "manifest_version": 3,
    "name": "nico downloader",
    "description": "ニコニコからの動画保存をサポートする他、ニコニコを便利に使うための非公式の拡張機能です。",
    "version": "5.0.0.20",
    "icons": {
        "16": "icon_16.png",
        "48": "icon_48.png",
        "128": "icon_128.png"
    },
    "permissions": [
        "storage"
    ],
    "web_accessible_resources": [
        {
            "matches": [
                "https://www.nicovideo.jp/*"
            ],
            "resources": [
                "options.html",
                "ffmpeg/ffmpeg-core2.js",
                "ffmpeg/ffmpeg-core.wasm",
                "ffmpeg/utils.js",
                "func/nicojson.js",
                "func/ndl.js"
            ]
        }
    ],
    "content_scripts": [
        {
            "matches": [
                "https://www.nicovideo.jp/*"
            ],
            "js": [
                "nicovideo_start.js",
                "options.js",
                "ffmpeg/ffmpeg-core2.js",
                "ffmpeg/utils.js",
                "func/nicojson.js",
                "func/ndl.js"
            ]
        },
        {
            "matches": [
                "https://dic.nicovideo.jp/*"
            ],
            "js": [
                "dic_start.js",
                "options.js"
            ]
        }
    ],
    "options_page": "options.html"
}